# ---------------------------------------------------------------------------
# OPEN STORE — Supabase configuration (optional but recommended for GitHub → Vercel)
#
# Set these two variables and every visitor gets a working store, on any device,
# with no config.json and no setup wizard. Next.js inlines NEXT_PUBLIC_* values
# into the build, so they must be present when the site is BUILT (a redeploy
# picks up changes).
#
# In Vercel:  Project → Settings → Environment Variables → add both → Redeploy.
# Locally:    copy this file to `.env.local` and fill in your values.
#
# Find them in Supabase:  Project Settings → API
#   - Project URL     → NEXT_PUBLIC_SUPABASE_URL
#   - anon public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is public by design (it ships in the browser bundle). Never put
# your service_role key here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional: your site's public URL, used for shared-link previews (the
# thumbnail card shown on WhatsApp / Facebook / X). On Vercel this is detected
# automatically, so you usually don't need to set it. Set it only to override —
# e.g. when you use a custom domain:  NEXT_PUBLIC_SITE_URL=https://yourstore.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Card payments (Stripe) — OPTIONAL.
#
# Leave these empty and the store simply doesn't offer card payment: checkout
# stays cash-on-delivery only, exactly as before. Fill them in and shoppers get
# a "Pay with card" option next to Cash on delivery.
#
# These are SECRETS. They are only ever read on the server (src/app/api/**),
# never sent to the browser, and must never be prefixed with NEXT_PUBLIC_.
#
#  1. STRIPE_SECRET_KEY — Stripe Dashboard → Developers → API keys.
#     Use sk_test_… while testing, sk_live_… when you go live. A restricted key
#     (rk_…) also works if it has WRITE permission on Checkout Sessions.
#
#  2. SUPABASE_SERVICE_ROLE_KEY — Supabase → Project Settings → API →
#     service_role. REQUIRED for card payments: row-level security blocks
#     everyone but the logged-in admin from updating orders, so this is what
#     lets a confirmed payment be written to the order. Without it a shopper
#     can pay and the order still reads "Unpaid". NEVER expose it in the
#     browser or commit it.
#
#  3. STRIPE_WEBHOOK_SECRET — Stripe Dashboard → Developers → Webhooks → add an
#     endpoint pointing at:
#         https://<your-site>/api/stripe/webhook/      ← keep the trailing slash
#     subscribe it to `checkout.session.completed`, then copy its signing
#     secret (whsec_…).
#
#     Payments are already confirmed when the shopper returns to the site, so
#     this is the safety net for the case where they close Stripe's tab before
#     coming back. Strongly recommended in production; not needed to test
#     locally.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Team invitations (Resend) — OPTIONAL.
#
# Needed only to email an invitation from Admin → Team. Without it you can still
# manage roles; you just can't send the invite email.
#
#  RESEND_API_KEY — resend.com → API Keys. A secret: server-side only.
#
#  RESEND_FROM    — the address invitations are sent FROM. Defaults to
#                   onboarding@resend.dev, which works immediately but ONLY
#                   delivers to your own Resend account email. To invite anyone
#                   else you must verify a domain in Resend and set this to an
#                   address on it, e.g. team@yourstore.com.
#
# Inviting also requires SUPABASE_SERVICE_ROLE_KEY above — creating the
# teammate's login uses the Supabase Admin API.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
